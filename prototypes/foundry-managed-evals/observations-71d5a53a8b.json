    "prototype_numeric_contract": {
      "definition": {
        "type": "code",
        "code_text": "def grade(sample, item) -> float:\n    value = item[\"value\"]\n    if value == \"exception\":\n        raise ValueError(\"unavailable: deliberate probe\")\n    if value == \"null\":\n        return None\n    if value == \"object\":\n        return {\"value\": 0.75, \"reason\": \"probe\", \"evidence_count\": 4}\n    if value == \"nan\":\n        return float(\"nan\")\n    if value == \"infinity\":\n        return float(\"inf\")\n    if value == \"timeout\":\n        import time\n        time.sleep(130)\n        return 0.75\n    return float(value)\n",
